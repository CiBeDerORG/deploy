{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "provider": {
    "myai": {
      "name": "myai",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://${MYAI_IP}:8080/v1"
      },
      "models": {
        "gpt-6-astra": {
          "name": "gpt-6-astra",
          "reasoning": true,
          "tool_call": true,
          "modalities": {
            "input": [
              "text",
              "image",
              "video",
              "audio",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "options": {
            "reasoningEffort": "ultra"
          },
          "variants": {
            "轻度": {
              "reasoningEffort": "low"
            },
            "中": {
              "reasoningEffort": "medium"
            },
            "高": {
              "reasoningEffort": "high"
            },
            "极高": {
              "reasoningEffort": "xhigh"
            },
            "最高 Ultra": {
              "reasoningEffort": "ultra"
            }
          }
        },
