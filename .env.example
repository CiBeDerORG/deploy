# <SOFTWARE_ROOT>/deploy/.env 普通配置模板
# 这里只放路径、端口、地址、角色、开关等普通配置。
# 账号、密码、Token、密钥等敏感信息请放到 <SOFTWARE_ROOT>/deploy/.secrets。

# ==================================================
# 全局
# ==================================================
SOFTWARE_ROOT=/software
# fnOS:
# SOFTWARE_ROOT=/vol3/1000/software
TZ=Asia/Shanghai

# ==================================================
# 服务端口
# ==================================================
FRPS_BIND_PORT=7000
FRPS_DASHBOARD_PORT=7001
OPENCODE_PORT=7003
PORTAINER_HTTP_PORT=7004
EASYTIER_PORT=7005
EASYTIER_RPC_PORT=7006
EASYTIER_WEB_PORT=7007
EASYTIER_CONFIG_PORT=7008
FLATNAS_HTTP_PORT=7009
SUB2API_HTTP_PORT=7010
MIHOMO_MIXED_PORT=7011
MIHOMO_API_PORT=7012
MIHOMO_CORE_API_PORT=7013

# ==================================================
# FRPS
# ==================================================
FRPS_PROXY_PORTS='["3389","7100-7800"]'

# ==================================================
# OpenCode
# ==================================================
# 已有公网 IP 配置也会用于 Mihomo 首次初始化 CORS：http://<MYAI_IP>:7012。
MYAI_IP=203.0.113.10
# Docker build 需要代理时可启用：
# BUILD_HTTP_PROXY=http://host.docker.internal:7890
# BUILD_HTTPS_PROXY=http://host.docker.internal:7890
BUILD_NO_PROXY=127.0.0.1,localhost

# ==================================================
# EasyTier
# ==================================================
# cloud: 云端 Web + Config Server + 由 Web 管理的 cloud Core
# intranet: 内网节点，只运行 Core，并连接远端 Web Config Server
EASYTIER_ROLE=cloud
EASYTIER_PRIVILEGED=false
# 可选，仅 cloud 模式使用：true 允许 Web 自助注册；false 关闭。
# 默认 true；留空或未配置也保持允许注册，已有账号仍可登录。
EASYTIER_WEB_ENABLE_REGISTRATION=true

# cloud 模式建议填写浏览器可以访问到的 Web 地址。
# EASYTIER_WEB_API_HOST=http://203.0.113.10:7007
EASYTIER_WEB_API_HOST=

# cloud Core 固定连接本机 udp://127.0.0.1:7008/admin。
# 网络名、密钥、IPv4 和安全 flags 均在云端 Web 页面设置。

# intranet 模式填写云端 Config Server。
# EASYTIER_CONFIG_SERVER=udp://203.0.113.10:7008/admin
# cloud 模式保持为空；cloud Core 自动连接本机 Config Server。
EASYTIER_CONFIG_SERVER=

# ==================================================
# Portainer
# ==================================================
# Edge Agent Tunnel 当前默认不开放；需要时再修改 Compose。
PORTAINER_EDGE_PORT=8000
PORTAINER_EDGE_CONTAINER_PORT=8000

# ==================================================
# GitHub Actions Runner
# ==================================================
GITHUB_RUNNER_URL=
GITHUB_RUNNER_NAME=
GITHUB_RUNNER_LABELS=
GITHUB_RUNNER_GROUP=
GITHUB_RUNNER_USER=github-runner
GITHUB_RUNNER_PROXY=

# ==================================================
# FlatNas
# ==================================================
# 绑定所有 IPv4 地址以便局域网 / EasyTier 访问，公网请使用防火墙限制来源。
FLATNAS_BIND_IP=0.0.0.0
# false 默认不授予宿主机 Docker 管理权限，确实需要容器管理才设为 true。
FLATNAS_DOCKER_SOCKET=false

# ==================================================
# Sub2API
# ==================================================
# Web 默认监听全部 IPv4；公网请通过防火墙 / HTTPS 反向代理保护。
SUB2API_BIND_IP=0.0.0.0

# ==================================================
# Mihomo
# ==================================================
# 代理 7011 默认仅宿主机回环可访问，不向其他设备开放代理端口。
MIHOMO_PROXY_BIND_IP=127.0.0.1
# All-in-One：7012 为 Web/Agent（不再是内核 API），默认向局域网/EasyTier 设备开放。
# 注意 CONTROL_TOKEN 由官方提供给浏览器，不能当作网页登录密码；用防火墙限制来源。
MIHOMO_API_BIND_IP=0.0.0.0
# 7013 为独立的 Clash/Mihomo 内核 API；浏览器需要直连，请在防火墙限制来源。
MIHOMO_CORE_API_BIND_IP=0.0.0.0
