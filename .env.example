# 已接入商店的应用在 <应用>/config.yaml、secrets.yaml 维护，运行值位于 <SOFTWARE_ROOT>/<应用>/config/。
# 现存全局文件中的旧应用值继续保留，首次运行新脚本时按缺失项迁移。
# <SOFTWARE_ROOT>/deploy/.env 普通配置模板
# 这里只放路径、端口、地址、角色、开关等普通配置。
# 账号、密码、Token、密钥等敏感信息请放到 <SOFTWARE_ROOT>/deploy/.secrets。
# 所有镜像、原生二进制 Release 版本统一读取仓库内真实的 lib/versions.env，部署时自动同步。
# 本文件不再提供任何 IMAGE/RELEASE 版本字段，旧 .env 值会在初始化时清理。

# ==================================================
# 全局
# ==================================================
SOFTWARE_ROOT=/opt/software
# fnOS:
# SOFTWARE_ROOT=/vol3/1000/software
TZ=Asia/Shanghai

# 全局 GHCR 镜像源（可选；留空/未配置时为 original），所有部署项目共用。
# 只处理 ghcr.io；Docker Hub、MCR 等其他来源的镜像地址原样保留。
# original：原始仓库；mirror：使用加速站，每次包含 GHCR 镜像的安装/更新轮换一次。
DOCKER_IMAGE_SOURCE=original
# 可选，逗号分隔，留空使用 dockerproxy,ghproxy；同次部署的 GHCR 镜像共用一站。
# 其他内置站点：nju、1ms、daocloud；使用限制见 README。
# 轮换记录保存在 <SOFTWARE_ROOT>/deploy/state/，不会改写各项目的原始镜像配置。
DOCKER_IMAGE_MIRRORS=dockerproxy,ghproxy

# GitHub Release 文件下载源（独立于 Docker 镜像下载；默认启用加速站）。
# mirror：每次在线安装/更新按列表轮换首选站，失败自动切下一站，全部失败再尝试 GitHub 官方。
# 本地上传的 EASYHOSTAGENT_LOCAL_BINARY 不参与网络下载和轮换。
GITHUB_RELEASE_SOURCE=mirror
# 可选：ghproxy=gh-proxy.org, ghfast=ghfast.top, ghproxy-net=ghproxy.net
GITHUB_RELEASE_MIRRORS=ghproxy,ghfast,ghproxy-net

# EasyHostAgent：Linux AMD64/ARM64 与 macOS ARM64 共用仓库 lib/versions.env 中的 Release 标签。
# Linux/fnOS 本地包留空时自动下载对应架构并校验；填写后使用上传文件和同名 .sha256。
EASYHOSTAGENT_LOCAL_BINARY=
EASYHOSTAGENT_TRANSPORT=https
EASYHOSTAGENT_LISTEN_ADDRESS=0.0.0.0:7018
EASYHOSTAGENT_LOG_LEVEL=info
EASYHOSTAGENT_DATA_DIR=/var/lib/easyhostagent
EASYHOSTAGENT_SOFTWARE_ROOT=
# 可选：Mac 本地可信 darwin/arm64 文件绝对路径，须同时存在同名 .sha256；留空使用仓库 lib/versions.env 的 Release。
EASYHOSTAGENT_MACOS_LOCAL_BINARY=
# 可选：fnos 或 linux；留空时由 Agent 检测（飞牛 Debian 内核可通过 /usr/trim/etc/version 识别）。
# 飞牛如出现软件根目录 UID 1000 的所有权错误，可明确设为 fnos。
EASYHOSTAGENT_PLATFORM=
# 可选：内网反向接入的 EasyNetTopo HTTPS 根地址；为空时保持原有直连模式。
EASYHOSTAGENT_CONTROLLER_URL=
# 格式：控制端UUID/来源UUID/应用ID；例如分别授权 sub2api 和 portainer。
# 两段格式 控制端UUID/来源UUID 为兼容旧版的整个来源授权（包括同源其他应用）。
# EASYHOSTAGENT_APP_GRANTS 已废弃：配对成功后无需逐个应用授权。
# EasyNetTopo 控制端。默认从 GHCR 拉取 GitHub Actions 发布的镜像。
# 0.0.0.0：监听所有 IPv4 网卡；127.0.0.1：仅本机访问。HTTP 公网访问须配置防火墙与 HTTPS。
EASYNETTOPO_BIND_IP=0.0.0.0
EASYNETTOPO_GIT_ALLOWED_HOSTS=github.com
EASYNETTOPO_GIT_ALLOW_HTTP=false

# ==================================================
# 服务端口
# ==================================================
FRPS_BIND_PORT=7000
FRPS_DASHBOARD_PORT=7001
EASYTIER_PORT=7005
EASYTIER_RPC_PORT=7006
EASYTIER_WEB_PORT=7007
EASYTIER_CONFIG_PORT=7008
FLATNAS_HTTP_PORT=7009
WEBTOP_HTTPS_PORT=7014
FNOS_DESKTOP_HTTPS_PORT=7015
OPENHANDS_PORT=7016
EASYNETTOPO_HTTP_PORT=7017

# ==================================================
# OpenHands Agent Canvas
# ==================================================
# OpenHands 镜像由仓库 lib/versions.env 统一指定；GHCR 加速来源仍由下方全局选项控制。
# 默认监听局域网/EasyTier，必须通过防火墙限制访问，严禁直接暴露公网。
OPENHANDS_BIND_IP=0.0.0.0

# ==================================================
# FRPS
# ==================================================
FRPS_PROXY_PORTS='["3389","7100-7800"]'

# ==================================================
# 共享访问地址与构建代理
# ==================================================
# 已有公网 IP 配置也会用于 Mihomo 首次初始化 CORS：http://<MYAI_IP>:7012。
MYAI_IP=203.0.113.10
# Docker build 需要代理时可启用：
# BUILD_HTTP_PROXY=http://host.docker.internal:7890
# BUILD_HTTPS_PROXY=http://host.docker.internal:7890
BUILD_NO_PROXY=127.0.0.1,localhost

# ==================================================
# EasyTier
# ==================================================
# EasyTier 镜像从 lib/versions.env 读取，cloud/intranet 共用。
# cloud: 云端 Web + Config Server + 由 Web 管理的 cloud Core
# intranet: 内网节点，只运行 Core，并连接远端 Web Config Server
EASYTIER_ROLE=cloud
# 可选：容器主机名，cloud/intranet 均使用；留空或未配置时为 easytier。
EASYTIER_HOSTNAME=easytier
EASYTIER_PRIVILEGED=false
# 可选，仅 cloud 模式使用：true 允许 Web 自助注册；false 关闭。
# 默认 true；留空或未配置也保持允许注册，已有账号仍可登录。
EASYTIER_WEB_ENABLE_REGISTRATION=true

# cloud 模式建议填写浏览器可以访问到的 Web 地址。
# EASYTIER_WEB_API_HOST=http://203.0.113.10:7007
EASYTIER_WEB_API_HOST=

# cloud Core 固定连接本机 udp://127.0.0.1:7008/admin。
# 网络名、密钥、IPv4 和安全 flags 均在云端 Web 页面设置。

# intranet 模式填写云端 Config Server。
# EASYTIER_CONFIG_SERVER=udp://203.0.113.10:7008/admin
# cloud 模式保持为空；cloud Core 自动连接本机 Config Server。
EASYTIER_CONFIG_SERVER=

# ==================================================
# EasyTier Automation Executor（独立手机执行器；只支持 Linux amd64）
# ==================================================
# 执行器与 EasyTier Web/Core 分开更新；如需固定 sha-<commit> 标签，请修改 lib/versions.env。
# 本机同机部署可用 127.0.0.1；跨机访问时设置为可信私网/EasyTier 可达监听地址，
# 或使用 0.0.0.0 并在防火墙限制来源，不要将此认证 API 裸露到公网。
EASYTIER_EXECUTOR_BIND_IP=127.0.0.1
EASYTIER_EXECUTOR_PORT=8766
# 必填：执行器能够访问的 EasyTier 主服务后端 URL（不是浏览器的 localhost）。
# 举例：EASYTIER_EXECUTOR_CALLBACK_URL=http://10.10.10.1:7007
EASYTIER_EXECUTOR_CALLBACK_URL=
EASYTIER_EXECUTOR_MAX_RUNNING=2
EASYTIER_EXECUTOR_MAX_PENDING=30
EASYTIER_EXECUTOR_MAX_MEDIA_SESSIONS=10
EASYTIER_EXECUTOR_MAX_MEDIA_STARTING=2
# 标准 ICE/TURN JSON 数组；TURN_SECRET 敏感值填写在 deploy/.secrets。
EASYTIER_EXECUTOR_ICE_SERVERS=[]
EASYTIER_EXECUTOR_TURN_URLS=[]
EASYTIER_EXECUTOR_TURN_TTL_SECONDS=3600

# ==================================================
# GitHub Actions Runner
# ==================================================
GITHUB_RUNNER_URL=
GITHUB_RUNNER_NAME=
GITHUB_RUNNER_LABELS=
GITHUB_RUNNER_GROUP=
GITHUB_RUNNER_USER=github-runner
GITHUB_RUNNER_PROXY=

# ==================================================
# FlatNas
# ==================================================
# 绑定所有 IPv4 地址以便局域网 / EasyTier 访问，公网请使用防火墙限制来源。
FLATNAS_BIND_IP=0.0.0.0
# false 默认不授予宿主机 Docker 管理权限，确实需要容器管理才设为 true。
FLATNAS_DOCKER_SOCKET=false

# ==================================================
# LinuxServer Webtop (Debian XFCE, HTTPS)
# ==================================================
WEBTOP_BIND_IP=0.0.0.0
WEBTOP_PUID=1000
WEBTOP_PGID=1000
WEBTOP_USER=desktop

# ==================================================
# fnOS Desktop：宿主机原生 XFCE4（不使用 Docker）
# ==================================================
# https://<NAS-IP>:7015/vnc.html；仅限可信内网或 EasyTier，不向公网暴露。
FNOS_DESKTOP_BIND_IP=0.0.0.0
FNOS_DESKTOP_RESOLUTION=1920x1080
FNOS_DESKTOP_USER=fnosdesktop
# true: 在安装时只运行 apt-get update（不会执行全系统 upgrade）
FNOS_DESKTOP_APT_UPDATE=true
