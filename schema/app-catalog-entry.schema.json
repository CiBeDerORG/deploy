{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deploy 应用商店条目",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "summary", "category"],
  "oneOf": [
    { "required": ["catalog_only"] },
    { "required": ["native_install"] }
  ],
  "dependentSchemas": {
    "native_install": { "properties": { "id": { "const": "maestro" } } }
  },
  "properties": {
    "catalog_only": { "const": true },
    "native_install": { "const": "macos_homebrew" },
    "enabled": { "type": "boolean", "default": true },
    "id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "category": {
      "enum": ["infrastructure", "network", "developer", "media", "productivity", "other"]
    },
    "icon": {
      "type": "string",
      "pattern": "^assets/[A-Za-z0-9_-]+\\.(svg|png|webp)$",
      "maxLength": 256
    }
  }
}
