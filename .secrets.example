# <SOFTWARE_ROOT>/deploy/.secrets 敏感配置模板
# 这里只放账号、密码、Token、密钥。
# 真实文件由 deploy.sh env 创建，权限固定为 root:root 0600。
# 禁止提交真实 .secrets。

OPENCODE_SERVER_PASSWORD=

FRPS_DASHBOARD_USER=admin
FRPS_DASHBOARD_PASSWORD=

PORTAINER_ADMIN_PASSWORD=

# EasyTier cloud no-relay P2P 协调 Core 使用。
# 升级旧部署时如果 data/core/*.toml 中已有 network_secret，可自动迁移；新部署请填写。
EASYTIER_CLOUD_NETWORK_SECRET=

# 仅首次注册 Runner 时需要；注册成功后可以清空。
GITHUB_RUNNER_TOKEN=
