# 已接入商店的应用在 <应用>/config.yaml、secrets.yaml 维护，运行值位于 <SOFTWARE_ROOT>/<应用>/config/。
# 现存全局文件中的旧应用值继续保留，首次运行新脚本时按缺失项迁移。
# <SOFTWARE_ROOT>/deploy/.secrets 敏感配置模板
# 这里只放账号、密码、Token、密钥。
# 真实文件由 deploy.sh env 创建，权限固定为 root:root 0600。
# 禁止提交真实 .secrets。

# OpenHands Agent Canvas：可选，空值或省略时首次安装自动生成并持久化。
# 更新不会重置现有非空 Token；请勿提交真实 .secrets。
OPENHANDS_API_KEY=

FRPS_DASHBOARD_USER=admin
FRPS_DASHBOARD_PASSWORD=

# EasyTier 网络密钥现在在 Web 页面设置，无需在此填写。

# 独立手机执行器；首次 install 时仅空 Token 会自动生成并保存在本文件。
# 该值必须与 EasyTier 自动化中心 → 设置 中保存的 Token 一致，升级时不重置。
EASYTIER_EXECUTOR_TOKEN=
# 可选：仅配置 TURN 中继时使用（与 .env 的 TURN_URLS 配套）。
EASYTIER_EXECUTOR_TURN_SECRET=

# 仅首次注册 Runner 时需要；注册成功后可以清空。
GITHUB_RUNNER_TOKEN=

# FlatNas 后端可选代理；含账号密码时仅放在真实 .secrets。
FLATNAS_PROXY_URL=

# Webtop：留空时首次安装自动生成；仅在可信内网访问 HTTPS 入口。
WEBTOP_PASSWORD=

# fnOS 原生桌面 VNC 密码：留空则首次安装自动生成 8 位字母数字；明文只保存在真实 .secrets。
FNOS_DESKTOP_VNC_PASSWORD=

# EasyNetTopo 首次初始化。账号留空取 admin，密码留空时首次生成并保存。
EASYNETTOPO_ADMIN_USERNAME=admin
EASYNETTOPO_ADMIN_PASSWORD=

# EasyNetTopo GitHub Actions / 自动化更新 Hook；留空时禁用，至少 32 字符。
EASYNETTOPO_HOOK_TOKEN=

