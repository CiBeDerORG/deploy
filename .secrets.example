# <SOFTWARE_ROOT>/deploy/.secrets 敏感配置模板
# 这里只放账号、密码、Token、密钥。
# 真实文件由 deploy.sh env 创建，权限固定为 root:root 0600。
# 禁止提交真实 .secrets。

OPENCODE_SERVER_PASSWORD=

FRPS_DASHBOARD_USER=admin
FRPS_DASHBOARD_PASSWORD=

PORTAINER_ADMIN_PASSWORD=

# EasyTier 网络密钥现在在 Web 页面设置，无需在此填写。

# 独立手机执行器；首次 install 时仅空 Token 会自动生成并保存在本文件。
# 该值必须与 EasyTier 自动化中心 → 设置 中保存的 Token 一致，升级时不重置。
EASYTIER_EXECUTOR_TOKEN=
# 可选：仅配置 TURN 中继时使用（与 .env 的 TURN_URLS 配套）。
EASYTIER_EXECUTOR_TURN_SECRET=

# 仅首次注册 Runner 时需要；注册成功后可以清空。
GITHUB_RUNNER_TOKEN=

# FlatNas 后端可选代理；含账号密码时仅放在真实 .secrets。
FLATNAS_PROXY_URL=

# Sub2API：以下四项均为可留空输入；首次安装解析空值后自动生成并持久化，
# 不要求手动提供，已填写的非空值不会被替换。
SUB2API_POSTGRES_PASSWORD=
SUB2API_REDIS_PASSWORD=
SUB2API_JWT_SECRET=
SUB2API_TOTP_ENCRYPTION_KEY=
# 后台账户：两项可分别留空；官方首次初始化分别生成缺省项并写入首次日志。
# 仅遵循 Sub2API 官方首次初始化密码要求：8-72 字节（不是额外限定字符集）。
SUB2API_ADMIN_EMAIL=
SUB2API_ADMIN_PASSWORD=
# 可选：Sub2API 在线更新代理 URL，可能包含凭据。
SUB2API_UPDATE_PROXY_URL=

# MetaCubeXD All-in-One：自定义密钥原样使用；留空时才自动生成。
# MIHOMO_API_SECRET 沿用旧值，现为官方 CLASH_SECRET（内核 7013）。
# MIHOMO_CONTROL_TOKEN 是官方 CONTROL_TOKEN（Web Agent），不是网页登录认证。
MIHOMO_CONTROL_TOKEN=
MIHOMO_API_SECRET=
MIHOMO_PROXY_USER=deploy
MIHOMO_PROXY_PASSWORD=
