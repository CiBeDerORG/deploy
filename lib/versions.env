# deploy 所有镜像与下载的二进制版本唯一来源（Git 仓库内的真实文件）。
# 安装/更新时由 deploy.sh / deploy.ps1 自动同步，不需要复制 .example 或改名。
# 配置格式只允许 KEY=VALUE；这里不是 shell 脚本，不允许变量展开或命令。
# 要改变版本：修改本文件并提交代码；deploy/.env / 应用 config/.env 不再负责版本。
#
# 移动标签 latest / lts / feat-* 延续原先的滚动更新语义；
# 如需要固定发布，在此改成版本号或 digest 即可。下载源和端口仍使用 .env。

# GitHub Release：Linux/fnOS amd64/arm64 与 macOS arm64 使用同一标签
EASYHOSTAGENT_RELEASE=v0.1.0-deploy-manifest-lifecycle.dev
GITHUB_RUNNER_VERSION=latest

# 控制端、网络与应用镜像
EASYNETTOPO_IMAGE=ghcr.io/cibederorg/easynettopo:main
EASYTIER_IMAGE=ghcr.io/easytier/easytier:v2.6.4
EASYTIER_EXECUTOR_IMAGE=ghcr.io/cibederorg/easytier-automation-executor:feat-automation-center
FRPS_IMAGE=ghcr.io/cibeder/frps:dev-multi-latest
PORTAINER_IMAGE=portainer/portainer-ce:lts
FLATNAS_IMAGE=qdnas/flatnas:latest
WEBTOP_IMAGE=lscr.io/linuxserver/webtop:debian-xfce
OPENHANDS_IMAGE=ghcr.io/openhands/agent-canvas:latest
QODER2API_HUB_IMAGE=ghcr.io/shuishuipingan/qoder2api-hub:latest
MIHOMO_IMAGE=ghcr.io/metacubex/metacubexd-server:latest
SUB2API_IMAGE=weishaw/sub2api:latest
SUB2API_POSTGRES_IMAGE=postgres:18-alpine
SUB2API_REDIS_IMAGE=redis:8-alpine

# OpenCode：基础构建镜像、自建镜像标签、官方 CLI 安装版本
OPENCODE_BASE_IMAGE=mcr.microsoft.com/devcontainers/typescript-node:24
OPENCODE_LOCAL_IMAGE=opencode-local:latest
OPENCODE_CLI_VERSION=latest

# Mihomo 原生（非 Docker）发布策略及 Node 二进制版本
# latest：构建时解析官方最新发布；upstream：从该发布的 server Dockerfile 获取内核版本
MIHOMO_METACUBEXD_VERSION=latest
MIHOMO_KERNEL_VERSION=upstream
MIHOMO_NODE_VERSION=v22.23.4
